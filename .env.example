# ── APP ────────────────────────────────────────────────────────────────────
MAINTENANCE_MODE=false
# Use "development" locally. Set to "production" when deploying.
ENVIRONMENT=development
DEBUG_MODE=true
CORS_ORIGINS=*
ADMIN_API_KEY=
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
ADMIN_DEFAULT_EMAIL=admin@enorsia.com
ADMIN_DEFAULT_PASSWORD=changeme123
ADMIN_DEFAULT_NAME=Admin
# Handoff schedule: false = agents available 24/7 (testing). true = enforce business hours.
HANDOFF_BUSINESS_HOURS_ENFORCED=false
# Set true only on real production servers (requires strong JWT_SECRET_KEY + ADMIN_API_KEY)
STRICT_SECURITY_ENFORCED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Per-session handoff limits (optional). Defaults: dev=100/15min, prod=3/15min
# HANDOFF_RATE_LIMIT_REQUESTS=100
HANDOFF_RATE_LIMIT_WINDOW_SECONDS=900
# Queue alert webhook (Slack/email bridge). Optional in development.
ALERT_WEBHOOK_URL=
QUEUE_ALERT_MINUTES=5
QUEUE_ALERT_CHECK_SECONDS=60
# Optional future PostgreSQL URL (SQLite used when empty)
# DATABASE_URL=postgresql://user:pass@localhost/enoxai


# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ── RAG tuning ────────────────────────────────────────────────────────────────
FAQ_DATA_PATH=data/faq.json
FAISS_INDEX_PATH=data/faiss_index
PRODUCT_FAISS_INDEX_PATH=data/product_faiss_index
PRODUCT_DATA_PATH=data/products.json
CHAT_STORE_PATH=data/enoxai.db
TOP_K_RESULTS=4
BM25_WEIGHT=0.4
SEMANTIC_WEIGHT=0.6
PRODUCT_MIN_RELEVANCE_SCORE=0.8


# ── Product Image RAG ───────────────────────────────────────────────────────────
IMAGE_JSON_PATH=data/product_images.json          
IMAGE_BASE_URL= https://enorsia.com/upload/ecom_products/  
IMAGE_INDEX_PATH=data/product_image_index.faiss
IMAGE_IDS_PATH=data/product_image_index_ids.pkl
IMAGE_TOP_K_RESULTS=5   
IMAGE_CLIP_MODEL=openai/clip-vit-base-patch32 
IMAGE_MIN_SIMILARITY=0.8
CHAT_UPLOAD_PATH=data/chat_uploads
IMAGE_JSON_URL=https://enorsiastaging.enoxsuite.com/llm_temp/product_images.json

# ── Laravel backend ───────────────────────────────────────────────────────────
ENOX_API_URL=http://localhost:8000
# Send ONE key only. Laravel INTERNAL_API_KEYS may list multiple valid keys.
ENOX_API_KEY=



# --- LangSmith Core Tracing Flags ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="EnoXAI"